{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeshRadio",
  "version": "0.01.6",
  "identifier": "com.heshradio.transceiver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HeshRadio // Tactical 40-Ch CB, SDR Waterfall & Internet Radio",
        "width": 1460,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
